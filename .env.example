# ID.me OIDC credentials (sandbox). Copy to .env and fill in.
# .env is gitignored — never commit real credentials.
# Verify exact discovery URL and scope names against the live docs:
#   https://docs.id.me/guides/open-id-connect/configuration

IDME_CLIENT_ID=
IDME_CLIENT_SECRET=
IDME_REDIRECT_URI=http://localhost:8765/callback
IDME_DISCOVERY_URL=https://api.id.me/.well-known/openid-configuration
IDME_SCOPES=openid

# Local issuer signing key (dev only). For production use a real KMS.
AGENT_PASSPORT_SIGNING_KEY_PATH=
AGENT_PASSPORT_ISSUER_URL=http://localhost:8000
